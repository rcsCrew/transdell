# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# O ".env" nunca deve ser commitado / compartilhado.

# Banco de dados (Laragon MySQL padrão)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema_do_paulo
DB_USER=root
DB_PASS=

# Cadeia de IA pra analisar as fotos: tenta na ordem, cai pro próximo se falhar.
VISION_PROVIDER=gemini,openrouter

# Chave da API da Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Chave da API do Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Chave da API do OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

# Chave da API do Groq (console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Contenção anti-loop / anti-custo-descontrolado.
LIMITE_IA_DIARIO=500
MAX_FOTOS_POR_ITEM=6

# E-mail (SMTP). Por padrão aponta pro Mailpit do Laragon (captura local,
# não envia de verdade — abra http://localhost:8025 pra ver os e-mails).
# Pra enviar de verdade (ex: Gmail), troque host/porta/usuario/senha e
# ligue MAIL_ENCRYPTION=tls, MAIL_PORT=587.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=
MAIL_FROM=checklist@frota.local
MAIL_FROM_NOME=Checklist de Frota
MAIL_TO=admin@frota.local

APP_URL=http://sistema-do-paulo.test
